# =============================================================================
# SYSeducore - example environment file
# Copy to .env and fill in real values.  NEVER commit the real .env.
# Every variable below is read by config/settings.py (or apps/reports/views.py).
# =============================================================================

# --- Django core -------------------------------------------------------------
# REQUIRED in production. With DEBUG=False the app refuses to start when
# SECRET_KEY is missing or still set to a well-known placeholder (SEC-04).
# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here-change-in-production

# MUST be False in production.
DEBUG=True

ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated origins (scheme + host [+ port]) allowed to POST forms.
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Comma-separated origins allowed to call the API from a browser (django-cors-headers).
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://sys.educore.software

# Only set to True when the app is served exclusively through a reverse proxy
# that OVERWRITES X-Forwarded-Proto. If gunicorn is reachable directly, leaving
# this True lets a client spoof "https" and defeat SECURE_SSL_REDIRECT (SEC-05).
TRUST_PROXY_SSL_HEADER=False

# Emergency kill-switch: True blocks ALL access and shows the "system closed"
# page. No redeploy needed - change the value and restart the process.
SYSTEM_LOCKOUT=False

# Directory for django.log (rotated at 10 MB x 5 backups). Falls back to
# console-only logging when the path is not writable.
LOG_DIR=logs

# --- Database ----------------------------------------------------------------
# Production uses PostgreSQL:
#   DB_ENGINE=django.db.backends.postgresql
#   DB_NAME=educore
#   DB_USER=educore
#   DB_PASSWORD=<strong-unique-password>
#   DB_HOST=db
#   DB_PORT=5432
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# --- Redis -------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# --- Celery ------------------------------------------------------------------
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# --- WhatsApp (Wapilot API v2 - the integration actually in use) --------------
# Dashboard: https://app.wapilot.net  ·  API docs: /api-doc/v2
# Token comes from Settings -> API tokens ("رموز الوصول").
# WAPILOT_INSTANCE_ID is the instance *unique name* shown on the WhatsApp
# Instances page (e.g. instance5136) — the bare digits are rejected with 404.
# The instance must have its QR code scanned: an instance sitting on
# SCAN_QR_CODE accepts the token but can never deliver a message.
WAPILOT_API_TOKEN=your-wapilot-api-token
WAPILOT_INSTANCE_ID=instanceXXXX
WAPILOT_API_BASE_URL=https://api.wapilot.net/api/v2

# --- Notifications -----------------------------------------------------------
# whatsapp | none
NOTIFICATION_METHOD=whatsapp

# If True, first-month students must pay before attending any session (0 grace sessions).
# If False, first-month students get the same 2-session grace period as returning students.
ENABLE_FIRST_MONTH_STRICT_PAYMENT=True

# --- Reports -----------------------------------------------------------------
# Password gate for the financial reports (apps/reports/views.py).
# Defaults to 888888 when unset - ALWAYS override in production.
REPORTS_PASSWORD=change-this-password

# --- GLM-4 API (optional) ----------------------------------------------------
GLM4_API_KEY=your_glm4_api_key
GLM4_API_URL=https://api.glm4.example.com

# --- Rate limiting -----------------------------------------------------------
RATELIMIT_ENABLE=True
