# Python
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
dist/
build/
*.egg

# Virtual environments
venv/
.venv/
env/

# Secrets / local environment
# .env is no longer tracked (untracked 2026-09-01). The values that were in the
# public history are being treated as compromised and rotated; the history
# itself still contains them, so rotation — not this rule — is what protects
# the system. Never re-add this file.
.env
.env.local
.env.*.local
!.env.example
*.pem
*.key

# Django
db.sqlite3
db.sqlite3.*
*.log
logs/
media/

